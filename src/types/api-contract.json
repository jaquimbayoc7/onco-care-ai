  "components": {
    "schemas": {
      "AlcoholConsumption": {
        "type": "string",
        "enum": [
          "Low",
          "Medium",
          "High"
        ],
        "title": "AlcoholConsumption"
      },
      "ChemotherapyReceived": {
        "type": "string",
        "enum": [
          "Yes",
          "No"
        ],
        "title": "ChemotherapyReceived"
      },
      "ClinicalHistoryCreate": {
        "properties": {
          "family_history": {
            "$ref": "#/components/schemas/FamilyHistory",
            "description": "Indicates if there is a family history of cancer."
          },
          "previous_cancer_history": {
            "$ref": "#/components/schemas/PreviousCancerHistory",
            "description": "Indicates if the patient has had cancer previously."
          },
          "stage_at_diagnosis": {
            "$ref": "#/components/schemas/StageAtDiagnosis",
            "description": "Cancer stage at diagnosis."
          },
          "tumor_aggressiveness": {
            "$ref": "#/components/schemas/TumorAggressiveness",
            "description": "Level of tumor aggressiveness."
          },
          "colonoscopy_access": {
            "$ref": "#/components/schemas/ColonoscopyAccess",
            "description": "Indicates if the patient has access to colonoscopy."
          },
          "screening_regularity": {
            "$ref": "#/components/schemas/ScreeningRegularity",
            "description": "Frequency or regularity of screening tests."
          },
          "diet_type": {
            "$ref": "#/components/schemas/DietType",
            "description": "Predominant diet type."
          },
          "bmi": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100,
                "minimum": 0
              },
              {
                "type": "string"
              }
            ],
            "title": "Bmi",
            "description": "Body Mass Index (BMI) value."
          },
          "physical_activity_level": {
            "$ref": "#/components/schemas/PhysicalActivityLevel",
            "description": "Physical activity level."
          },
          "smoking_status": {
            "$ref": "#/components/schemas/SmokingStatus",
            "description": "Patient's smoking status."
          },
          "alcohol_consumption": {
            "$ref": "#/components/schemas/AlcoholConsumption",
            "description": "Level of alcohol consumption."
          },
          "fiber_consumption": {
            "$ref": "#/components/schemas/FiberConsumption",
            "description": "Level of fiber consumption."
          },
          "insurance_coverage": {
            "$ref": "#/components/schemas/InsuranceCoverage",
            "description": "Patient's insurance coverage status."
          },
          "time_to_diagnosis": {
            "$ref": "#/components/schemas/TimeToDiagnosis",
            "description": "Timeliness of diagnosis."
          },
          "treatment_access": {
            "$ref": "#/components/schemas/TreatmentAccess",
            "description": "Patient's access to treatments."
          },
          "treatment_id": {
            "type": "integer",
            "title": "Treatment Id",
            "description": "ID of the recommended treatment."
          },
          "chemotherapy_received": {
            "$ref": "#/components/schemas/ChemotherapyReceived",
            "description": "Indicates if chemotherapy was received."
          },
          "radiotherapy_received": {
            "$ref": "#/components/schemas/RadiotherapyReceived",
            "description": "Indicates if radiotherapy was received."
          },
          "surgery_received": {
            "$ref": "#/components/schemas/SurgeryReceived",
            "description": "Indicates if surgery was received."
          },
          "treatment_recommendation": {
            "type": "string",
            "title": "Treatment Recommendation",
            "description": "AI treatment recommendation name."
          },
          "follow_up_adherence": {
            "$ref": "#/components/schemas/FollowUpAdherence",
            "description": "Degree of patient adherence to medical follow-up."
          },
          "recurrence": {
            "$ref": "#/components/schemas/Recurrence",
            "description": "Indicates if cancer recurrence occurred."
          },
          "time_to_recurrence": {
            "type": "integer",
            "minimum": 0,
            "title": "Time To Recurrence",
            "description": "Days until recurrence occurred."
          },
          "document_id": {
            "type": "string",
            "title": "Document Id",
            "description": "Document ID of the patient."
          }
        },
        "type": "object",
        "required": [
          "stage_at_diagnosis",
          "tumor_aggressiveness",
          "treatment_access",
          "follow_up_adherence",
          "document_id"
        ],
        "title": "ClinicalHistoryCreate",
        "example": {
          "alcohol_consumption": "Low",
          "bmi": 33,
          "chemotherapy_received": "Yes",
          "colonoscopy_access": "No",
          "diet_type": "Western",
          "document_id": "12345678",
          "family_history": "Yes",
          "fiber_consumption": "Low",
          "follow_up_adherence": "Good",
          "insurance_coverage": "Yes",
          "physical_activity_level": "Low",
          "previous_cancer_history": "No",
          "radiotherapy_received": "No",
          "recurrence": "No",
          "screening_regularity": "Regular",
          "smoking_status": "Never",
          "stage_at_diagnosis": "III",
          "surgery_received": "No",
          "time_to_diagnosis": "Delayed",
          "time_to_recurrence": 16,
          "treatment_access": "Adequate",
          "treatment_id": 10,
          "treatment_recommendation": "T2",
          "tumor_aggressiveness": "High"
        }
      },
